# Copy this file to .env and edit it.
#
#   cp .env.example .env
#
# .env is git-ignored, so the real values never end up in the repo.

# Signs sessions and CSRF tokens. Without a fixed value Django invents a
# new one in every worker process, so a login handled by one worker is not
# recognised by the next - you sign in, get bounced straight back out, and
# it looks random. Make one with:
#
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
#
DJANGO_SECRET_KEY=lF%+rgGrZo+#^HQ2paL+swWKx%KW&oCji+e93DX1eEvZ9xENDR

# Only used until you set a real one from inside the console.
C2_PASSWORD=admin

# --- Showing it to somebody else on your network -------------------
# Find your address with:  ipconfig getifaddr en0
# Then they open http://<that address>:8000
#
# BIND=0.0.0.0
# PUBLIC_HOST=192.168.21.13

# --- On the droplet -------------------------------------------------
# Leave BIND alone. Caddy takes 443 and forwards to 127.0.0.1:8000, so
# the link has no port in it.
#
BIND=127.0.0.1
PUBLIC_HOST=localhost

# Set to 1 only when Caddy is terminating TLS in front (the droplet).
# On a LAN over plain http this must stay unset or forms will 403.
HTTPS=0

# Whose console it is. Shown on the way in.
BRAND=evilucimx
